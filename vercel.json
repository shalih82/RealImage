{
  "buildCommand": "cd agents/output/app && npm install && npm run build",
  "outputDirectory": "agents/output/app/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
    "VITE_USE_SERVERLESS": "true"
  }
}
