# Optional: Forward enquiries to a webhook (Formspree, Zapier, custom server)
VITE_ENQUIRY_WEBHOOK=

# Recommended: Supabase project for persistent storage and multi-browser admin view
# Get these from your Supabase project settings (Anon key is fine for public writes)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Example usage:
# 1. copy this file to .env
# 2. fill SUPABASE_URL and SUPABASE_ANON_KEY values
# 3. restart dev server: npm run dev
# 4. admin will fetch enquiries from Supabase (visible across all browsers)
