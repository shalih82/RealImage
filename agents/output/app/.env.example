# Optional: Forward enquiries to a webhook (Formspree, Zapier, custom server)
VITE_ENQUIRY_WEBHOOK=

# Optional: Supabase project (for persistent storage and admin view)
# Get these from your Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SERVERLESS=

# Serverless (deploy) notes:
# If you enable Vercel serverless handling, set this to true and add the following
# to your Vercel project environment variables (do NOT commit service role keys):
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (service_role key)
# The client will post to /api/enquiries when VITE_USE_SERVERLESS=true

# Example usage:
# 1. copy this file to .env
# 2. fill values
# 3. restart dev server: npm run dev
